
#include <OneWire.h>
#include <DallasTemperature.h>
#include <Wire.h>
#include <SPI.h>
#include <SD.h>
#include <RTClib.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ---------------- PIN CONFIGURATION ----------------

#define ONE_WIRE_BUS 4

#define OLED_SDA 21
#define OLED_SCL 22

#define SD_CS   5
#define SD_MOSI 23
#define SD_MISO 19
#define SD_SCK  18

// ---------------- DISPLAY CONFIGURATION ----------------

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  OLED_RESET
);

// ---------------- SENSOR AND MODULE OBJECTS ----------------

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);

RTC_DS3231 rtc;

// ---------------- SYSTEM SETTINGS ----------------

// Logging interval: 1 hour
const unsigned long LOG_INTERVAL = 3600000UL;

unsigned long previousLogTime = 0;

bool oledAvailable = false;
bool rtcAvailable = false;
bool sdAvailable = false;

// ---------------- TEMPERATURE VARIABLES ----------------

float indoorTemp = 0.0;
float outdoorTemp = 0.0;
float deltaT = 0.0;

// ---------------- FILE CONFIGURATION ----------------

const char* fileName = "/temperature_log.csv";

// ---------------- OLED DISPLAY FUNCTION ----------------

void showMessage(String line1, String line2) {

  if (!oledAvailable) return;

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);

  display.setCursor(0, 10);
  display.println(line1);

  display.setCursor(0, 30);
  display.println(line2);

  display.display();
}

// ---------------- SETUP ----------------

void setup() {

  Serial.begin(115200);

  // Initialize I2C
  Wire.begin(OLED_SDA, OLED_SCL);

  // Initialize OLED
  oledAvailable = display.begin(
    SSD1306_SWITCHCAPVCC,
    0x3C
  );

  if (oledAvailable) {
    showMessage("Passive Cooling", "System Starting");
  }

  // Initialize DS18B20 sensors
  sensors.begin();

  Serial.println("DS18B20 sensors initialized");
  Serial.print("Number of sensors: ");
  Serial.println(sensors.getDeviceCount());

  // Initialize RTC
  if (rtc.begin()) {

    rtcAvailable = true;
    Serial.println("RTC initialized");

    if (rtc.lostPower()) {
      Serial.println("RTC lost power!");
      Serial.println("Set RTC time before logging.");
    }

  } else {
    Serial.println("RTC not detected");
  }

  // Initialize SD card
  SPI.begin(
    SD_SCK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  if (SD.begin(SD_CS)) {

    sdAvailable = true;
    Serial.println("SD card initialized");

    if (!SD.exists(fileName)) {

      File file = SD.open(fileName, FILE_WRITE);

      if (file) {
        file.println(
          "Date,Time,Indoor_Temp_C,"
          "Outdoor_Temp_C,Delta_T_C"
        );

        file.close();
      }
    }

  } else {
    Serial.println("SD card initialization failed");
  }

  showMessage("System Ready", "Monitoring Active");

  delay(2000);
}

// ---------------- DATA LOGGING FUNCTION ----------------

void logTemperatureData() {

  // Request temperature readings
  sensors.requestTemperatures();

  indoorTemp = sensors.getTempCByIndex(0);
  outdoorTemp = sensors.getTempCByIndex(1);

  // Check sensor availability
  bool indoorValid =
    indoorTemp != DEVICE_DISCONNECTED_C;

  bool outdoorValid =
    outdoorTemp != DEVICE_DISCONNECTED_C;

  // Read date and time
  DateTime now;

  if (rtcAvailable) {
    now = rtc.now();
  }

  // Calculate temperature difference
  if (indoorValid && outdoorValid) {
    deltaT = outdoorTemp - indoorTemp;
  }

  // ---------------- SERIAL MONITOR ----------------

  Serial.println("-----------------------------");

  if (rtcAvailable) {
    Serial.print("Date: ");
    Serial.println(
      now.timestamp(DateTime::TIMESTAMP_DATE)
    );

    Serial.print("Time: ");
    Serial.println(
      now.timestamp(DateTime::TIMESTAMP_TIME)
    );
  }

  if (indoorValid) {
    Serial.print("Indoor Temperature: ");
    Serial.print(indoorTemp);
    Serial.println(" C");
  } else {
    Serial.println("Indoor Sensor Error");
  }

  if (outdoorValid) {
    Serial.print("Outdoor Temperature: ");
    Serial.print(outdoorTemp);
    Serial.println(" C");
  } else {
    Serial.println("Outdoor Sensor Error");
  }

  if (indoorValid && outdoorValid) {
    Serial.print("Temperature Difference: ");
    Serial.print(deltaT);
    Serial.println(" C");
  }

  // ---------------- OLED DISPLAY ----------------

  if (oledAvailable) {

    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);

    display.setCursor(0, 0);
    display.println("PASSIVE COOLING");

    display.setCursor(0, 15);
    display.print("Indoor: ");

    if (indoorValid) {
      display.print(indoorTemp, 1);
      display.println(" C");
    } else {
      display.println("Sensor Error");
    }

    display.setCursor(0, 27);
    display.print("Outdoor: ");

    if (outdoorValid) {
      display.print(outdoorTemp, 1);
      display.println(" C");
    } else {
      display.println("Sensor Error");
    }

    display.setCursor(0, 39);
    display.print("Delta T: ");

    if (indoorValid && outdoorValid) {
      display.print(deltaT, 1);
      display.println(" C");
    } else {
      display.println("--");
    }

    display.setCursor(0, 52);

    if (sdAvailable) {
      display.print("SD: OK ");
    } else {
      display.print("SD: ERROR ");
    }

    if (rtcAvailable) {
      display.println("RTC: OK");
    } else {
      display.println("RTC: ERROR");
    }

    display.display();
  }

  // ---------------- SD CARD DATA LOGGING ----------------

  if (sdAvailable && rtcAvailable &&
      indoorValid && outdoorValid) {

    File file = SD.open(fileName, FILE_APPEND);

    if (file) {

      file.print(
        now.timestamp(DateTime::TIMESTAMP_DATE)
      );
      file.print(",");

      file.print(
        now.timestamp(DateTime::TIMESTAMP_TIME)
      );
      file.print(",");

      file.print(indoorTemp, 2);
      file.print(",");

      file.print(outdoorTemp, 2);
      file.print(",");

      file.println(deltaT, 2);

      file.close();

      Serial.println("Data saved successfully");

    } else {
      Serial.println("Error opening SD file");
    }

  } else {
    Serial.println("Data not saved: Check sensors, RTC or SD");
  }

  Serial.println("-----------------------------");
}

// ---------------- MAIN LOOP ----------------

void loop() {

  unsigned long currentTime = millis();

  // Take first reading immediately,
  // then repeat at the selected interval.
  if (previousLogTime == 0 ||
      currentTime - previousLogTime >= LOG_INTERVAL) {

    previousLogTime = currentTime;

    logTemperatureData();
  }
}
